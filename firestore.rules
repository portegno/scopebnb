rules_version = '2';

// ScopeBnB Firestore security rules.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles: each signed-in user can read/write only their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Bookings: a signed-in user can create their own and read/manage only theirs.
    match /bookings/{bookingId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Admin-user assignments (email -> permissions) are accessed exclusively via
    // the Firebase Admin SDK server-side, which bypasses these rules. Deny all
    // client access explicitly.
    match /adminUsers/{email} {
      allow read, write: if false;
    }

    // Blocked nights are written via the Admin SDK; the public booking calendar
    // reads availability through /api/availability, not Firestore directly.
    match /blockedNights/{date} {
      allow read, write: if false;
    }

    // Newsletter subscribers + sent-campaign history are written and read only
    // via the Admin SDK (POST /api/newsletter, /api/admin/newsletter). No client
    // access.
    match /newsletterSubscribers/{email} {
      allow read, write: if false;
    }
    match /newsletterCampaigns/{id} {
      allow read, write: if false;
    }
  }
}
