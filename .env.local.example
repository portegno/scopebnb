# Firebase web config (public values) — from console.firebase.google.com →
# Project settings → your web app → "SDK setup and configuration".
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abc123

# Google Gemini — server-side only, powers AI object descriptions (/api/object-info)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash-lite

# Admin dashboard — comma-separated Google account emails allowed into
# /admin and the /api/admin/* endpoints.
ADMIN_EMAILS=you@example.com

# Firebase Admin SDK credentials for LOCAL dev (Application Default Credentials).
# Download a service-account key from the Firebase console and point here.
# In production (App Hosting) this is NOT needed — the backend service account
# provides ADC automatically.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Resend — transactional + newsletter email (server-side only).
# Get an API key at resend.com → API Keys.
RESEND_API_KEY=re_your_key
# From address for outgoing mail. Requires the domain to be verified in Resend;
# until then use "ScopeBnB <onboarding@resend.dev>" (test mode).
NEWSLETTER_FROM=ScopeBnB <contact@scopebnb.com>
# Optional: Resend Audience id, so new subscribers are mirrored for Broadcasts.
RESEND_AUDIENCE_ID=

# Google Analytics 4 measurement ID (public, client-side). Leave empty to
# disable analytics. Because it's a NEXT_PUBLIC_* var it's inlined at build
# time, so changing it needs a rebuild/redeploy.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Stripe (added later for checkout)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
