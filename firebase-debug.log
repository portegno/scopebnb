shed/getPublishedBySlug\n  filter publishedAt <= now in memory, so it appears on its own.\n- PostEditor date/time picker with a Schedule action; admin list marks\n  \"Scheduled\".\n\nBlog image lightbox:\n- Click any post image (or the cover) to view it full-screen.\n\nCo-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>","uri":"https://github.com/portegno/scopebnb/commit/00eb2e465b052e5e61bd8dcb5e1ff42176d9b898","author":{"displayName":"portegno","email":"gabriel@portegno.com","imageUri":"https://github.com/portegno.png"},"commitTime":"2026-09-01T02:05:04Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/344db42c-80e3-46d9-9f71-ddaea35877c5?project=545100308806","createTime":"2026-09-01T02:05:13.750036676Z","updateTime":"2026-09-01T02:07:55.748696Z","displayName":"build-2026-09-01-001","uid":"4c916834-3f48-43cd-a129-f667c2871bed","etag":"Yj6QIndj5nu4k04oVKz7FZn5agr9q9B32rvvHJS-6Fk","reconciling":false},{"name":"projects/scopebnb/locations/us-central1/backends/scopebnb/builds/build-2026-09-01-003","state":"READY","image":"us-central1-docker.pkg.dev/scopebnb/firebaseapphosting-images/scopebnb:build-2026-09-01-003","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"scopebnb.firebaseapp.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"scopebnb","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"scopebnb.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"545100308806","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:545100308806:web:49692d66e4a1be12470547","availability":["BUILD","RUNTIME"]},{"variable":"GEMIN