EBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0\",\"appId\":\"1:545100308806:web:53f12e90e180139c470547\",\"authDomain\":\"scopebnb.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"545100308806\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"scopebnb-545100308806.us-central1.run.app,scopebnb-ew6odra35q-uc.a.run.app,t-2982868893---scopebnb-ew6odra35q-uc.a.run.app,scopebnb--scopebnb.us-central1.hosted.app,scopebnb.com,www.scopebnb.com","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"ff814f1bae953e3c1930ce0dd29ac9ed4a1b2292","hash":"ff814f1bae953e3c1930ce0dd29ac9ed4a1b2292","commitMessage":"The composer is source on the left and the real email on the right\n\nEmail HTML cannot go through a WYSIWYG without losing half of it: TipTap parses\nagainst its own schema and drops tables and inline styles, which is what\nflattened Mike's tip into a stack. So it is edited as text.\n\nWhat makes that usable is the other half: the pane next to it is the actual\nemail, rendered through the same wrapper that goes out, not an approximation.\nIt follows what you type with half a second of air, because asking per keystroke\nis a hundred calls to see one change.\n\nAn iframe and not a div, again: the email brings its own `<style>` and `<body>`,\nand injected into the page its rules mix with the admin's. There, what you see\nstops being what you send.\n\nSave keeps what you fixed without sending it. An edition you corrected and did\nnot send should still be corrected tomorrow.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","uri":"https://github.com/portegno/scopebnb/commit/ff814f1bae953e3c1930ce0dd29ac9ed4a1b2292","author":{"displayName":"portegno","email":"gabriel@portegno.com","imageUri":"https://github.com/portegno.png"},"commitTime":"2026-09-06T19:02:37Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/85cf2e6b-d547-4b16-9a2e-6156db810d6e?project=545100308806","createTime":"2026-09-06T19:02:42.960141262Z","updateTime":"2026-09-06T19:05:45.157646Z","displayName":"build-2026-09-06-007","uid":"069cb28c-80c6-48ee-b882-9ce403161136","etag":"hYucRPUW1YDiC9-_jYAD5kOwDrOghffHgwSnHQsTgA8","reconciling":false},{"name":"projects/scopebnb/locations/us-central1/backends/scopebnb/builds/build-2026-09-06-004","state":"READY","image":"us-central1-docker.pkg.dev/scopebnb/firebaseapphosting-images/scopebnb:build-2026-09-06-004","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"scopebnb.firebaseapp.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"scopebnb","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"scopebnb.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"545100308806","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:545100308806:web:49692d66e4a1be12470547","availability":["BUILD","RUNTIME"]},{"variable":"GEMINI_MODEL","value":"gemini-2.5-flash-lite","availability":["BUILD","RUNTIME"]},{"variable":"GEMINI_API_KEY","secret":"projects/545100308806/secrets/GEMINI_API_KEY/versions/1","availability":["RUNTIME"]},{"variable":"SESSION_INGEST_SECRET","secret":"projects/545100308806/secrets/SESSION_INGEST_SECRET/versions/1","availability":["RUNTIME"]},{"variable":"SUPER_ADMIN_EMAILS","value":"gabriel@pulpou.com","availability":["RUNTIME"]},{"v