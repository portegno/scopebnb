","secret":"projects/545100308806/secrets/RESEND_API_KEY/versions/1","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"NEWSLETTER_FROM","value":"ScopeBnB <contact@scopebnb.com>","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"RESEND_AUDIENCE_ID","value":"ebd3fb5c-bfb4-4709-ab2a-f27eed5c46e0","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"NEXT_PUBLIC_GA_ID","value":"G-F58PHV4VN9","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0\",\"appId\":\"1:545100308806:web:53f12e90e180139c470547\",\"authDomain\":\"scopebnb.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"545100308806\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"scopebnb-545100308806.us-central1.run.app,scopebnb-ew6odra35q-uc.a.run.app,t-2999646478---scopebnb-ew6odra35q-uc.a.run.app,scopebnb--scopebnb.us-central1.hosted.app,scopebnb.com,www.scopebnb.com","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"6fb9dc0ab57e0b928661eb6ae7641bf75106c3b4","hash":"6fb9dc0ab57e0b928661eb6ae7641bf75106c3b4","commitMessage":"El newsletter se va al edificio; acá queda la lista\n\nThis page was the whole newsletter: a composer, a draft queue, a live preview,\na history and a Send button. All of it moved to the Portegno building, under\nClippings, next to the clippings and the plans.\n\nWriting an edition, laying it out, asking design for a change and sending it are\nthe team's work, and the team's work is looked at in the building. Having it here\ntoo meant the same email had two homes and, worse, that the building could never\nshow it: the browser there reaches the agency's database, not this one.\n\nWhat stays is what is genuinely ours and does not travel: the people who gave us\ntheir address. They subscribe on the site, so they are counted on the site.\n\nGone with it: the composer's email mode in RichTextEditor (a post is semantic\nHTML, an email is tables, and one schema trying to be both makes the blog\nswallow tables from anything anyone pastes), the email shell template, and the\ntwo broadcast helpers. Two places able to send the same broadcast is one too\nmany for something that does not come back.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","uri":"https://github.com/portegno/scopebnb/commit/6fb9dc0ab57e0b928661eb6ae7641bf75106c3b4","author":{"displayName":"portegno","email":"gabriel@portegno.com","imageUri":"https://github.com/portegno.png"},"commitTime":"2026-09-06T20:13:45Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/a02b7d3c-84dd-4f11-8066-e52b0767f8ba?project=545100308806","createTime":"2026-09-06T20:17:39.287857153Z","updateTime":"2026-09-06T20:20:31.608115Z","displayName":"build-2026-09-06-013","uid":"b1821b0a-1120-4a30-b014-d88beabd852b","etag":"T_qZo42UhbfkH76RHZmV-kMDvRxNBQ6OO9LjbhDeJt0","reconciling":false},{"name":"projects/scopebnb/locations/us-central1/backends/scopebnb/builds/build-2026-09-06-012","state":"READY","image":"us-central1-docker.pkg.dev/scopebnb/firebaseapphosting-images/scopebnb:build-2026-09-06-012","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fN