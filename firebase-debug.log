"availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"545100308806","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:545100308806:web:49692d66e4a1be12470547","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"GEMINI_MODEL","value":"gemini-2.5-flash-lite","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"GEMINI_API_KEY","secret":"projects/545100308806/secrets/GEMINI_API_KEY/versions/1","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"SESSION_INGEST_SECRET","secret":"projects/545100308806/secrets/SESSION_INGEST_SECRET/versions/1","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"SUPER_ADMIN_EMAILS","value":"gabriel@pulpou.com","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"RESEND_API_KEY","secret":"projects/545100308806/secrets/RESEND_API_KEY/versions/1","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"NEWSLETTER_FROM","value":"ScopeBnB <contact@scopebnb.com>","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"RESEND_AUDIENCE_ID","value":"ebd3fb5c-bfb4-4709-ab2a-f27eed5c46e0","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"NEXT_PUBLIC_GA_ID","value":"G-F58PHV4VN9","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0\",\"appId\":\"1:545100308806:web:53f12e90e180139c470547\",\"authDomain\":\"scopebnb.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"545100308806\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"scopebnb-545100308806.us-central1.run.app,scopebnb-ew6odra35q-uc.a.run.app,t-277106829---scopebnb-ew6odra35q-uc.a.run.app,scopebnb--scopebnb.us-central1.hosted.app,scopebnb.com,www.scopebnb.com","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"56b4606996f13ec00c8e28d20eef2b3aab81ce39","hash":"56b4606996f13ec00c8e28d20eef2b3aab81ce39","commitMessage":"Resolve campaign links from a short code\n\nThe agency's outbound mail used to carry the whole strategy in the address bar:\nutm_source, utm_medium=outbound and the campaign name. The letter spoke to the\nreader about their own observatory; the link told them they were row seven of a\nmailing. Now the mail carries `?id=658vpp2q` and this resolves it server-side.\n\n**The greeting now arrives in the HTML.** It used to be read from `utm_source`\nby a client component, which meant a slow phone showed \"For astronomy clubs\"\nand swapped a second later — and it un-slugged the name, so a German club got\n\"Volkssternwarte Kempten e v\". The link record carries the name the club\nactually spells. The `utm_source` path stays as a fallback for the links that\nalready went out: those are real emails in real inboxes and they don't get\nreissued.\n\n`/l/club` becomes dynamic as a result, and that is the trade being made.\n\n**The cookie is set in `proxy.ts` and not on the page.** Next only allows\nwriting cookies from the proxy, a Server Action or a Route Handler — a Server\nComponent calling `cookies().set()` throws at render, which is a 500 on a page\nsomebody opened from a cold email we only get to send once. It found us: the\nfirst version did exactly that. Ninety days, because a club takes the idea to a\nmeeting and comes back a week later, sometimes from the observatory's other\ncomputer.\n\n**An unknown code renders the generic landing, not a 404.** These links get\nshared between members, copied wrong and forwarded months later; a dead link in\na cold email is a campaign that ends there with nobody to complain to.\n\n**The beacon hands GA4 the campaign as data.** Taking the utm out of the URL is\nright, but GA4's automatic acquisition reads exactly those parameters, so with a\nclean URL every one of these visits would land in reports as `(direct)` — the\ncampaign disappearing from analytics precisely because we hid it from the\nreader. Source, medium and name are set directly instead. **The contact's email\nis never sent**: Google's terms prohibit PII in Analytics and these are German\nclubs, so the account id goes and the join stays in our own database.\n\nOne step is left outside the code: `enlace_id` and `cuenta_id` have to be\nregistered as custom dimensions in the GA4 admin, or the parameters arrive and\nare simply not reportable.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","uri":"https://github.com/portegno/scopebnb/commit/56b4606996f13ec00c8e28d20eef2b3aab81ce39","author":{"displayName":"portegno","email":"gabriel@portegno.com","imageUri":"https://github.com/portegno.png"},"commitTime":"2026-09-10T13:53:16Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/f79dae69-7549-4efe-a552-70d8a71fe2b4?project=545100308806","createTime":"2026-09-10T13:53:22.664015527Z","updateTime":"2026-09-10T13:56:14.748807Z","displayName":"build-2026-09-10-006","uid":"96a15bf0-1f0d-46a0-837c-670c066e35fe","et