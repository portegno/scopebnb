ET/versions/1","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"SUPER_ADMIN_EMAILS","value":"gabriel@pulpou.com","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"RESEND_API_KEY","secret":"projects/545100308806/secrets/RESEND_API_KEY/versions/1","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"NEWSLETTER_FROM","value":"ScopeBnB <contact@scopebnb.com>","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"RESEND_AUDIENCE_ID","value":"ebd3fb5c-bfb4-4709-ab2a-f27eed5c46e0","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"NEXT_PUBLIC_GA_ID","value":"G-F58PHV4VN9","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0\",\"appId\":\"1:545100308806:web:53f12e90e180139c470547\",\"authDomain\":\"scopebnb.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"545100308806\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"scopebnb-545100308806.us-central1.run.app,scopebnb-ew6odra35q-uc.a.run.app,t-260329241---scopebnb-ew6odra35q-uc.a.run.app,scopebnb--scopebnb.us-central1.hosted.app,scopebnb.com,www.scopebnb.com","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"9934db70762e1555b611e23d15388d400dcf9ff8","hash":"9934db70762e1555b611e23d15388d400dcf9ff8","commitMessage":"Optimizar las fotos de objetivos, y usar las buenas\n\nLas versiones de 5 horas pesaban 6 y 8 MB, asi que la galeria iba con las\nlivianas y peores. Comprimidas con el criterio que ya usa la casa --2000px,\ncalidad 82, mozjpeg: lo mismo que quedo escrito en imagen.js despues de que una\nportada pesara 1,2 MB-- bajan un 96%:\n\n  ElephantsTrunk wide   6190 KB →  231 KB\n  ElephantsTrunk zoom   8303 KB →  338 KB\n  Andromeda             6128 KB →  386 KB\n\n**Y el archivo que se llamaba \"Andromeda_small\" era el mejor original**: mismas\ndimensiones que el otro y nueve veces mas bytes, o sea menos comprimido.\nOptimizando ese queda mas liviano *y* mejor que el que ya estaba comprimido.\n\nLa galeria pasa a cuatro: Andromeda a todo el ancho, y el mismo campo del\nElephant's Trunk ancho, cerca y en banda angosta. Las dos paletas del mismo dato\ndicen algo que un parrafo no dice: lo que se lleva un club es material, asi que\ncomo termina viendose sigue siendo decision suya.\n\nUn mega y medio en el repo para cuatro imagenes de 2000px, y Next las sirve mas\nchicas todavia segun la pantalla.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","uri":"https://github.com/portegno/scopebnb/commit/9934db70762e1555b611e23d15388d400dcf9ff8","author":{"displayName":"portegno","email":"gabriel@portegno.com","imageUri":"https://github.com/portegno.png"},"commitTime":"2026-09-10T15:14:54Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/a140278a-06a9-47cd-9ab1-e877c0cf8da1?project=545100308806","createTime":"2026-09-10T15:14:59.393551637Z","updateTime":"2026-09-10T15:18:31.759754Z","displayName":"build-2026-09-10-011","uid":"f1311850-f6ad-477f-af56-fc1ad4d1c77b","etag":"9kh6I_EIgHMWbAXA5KLGMbPpXVbt2XL1UPWL-C5O_v4","reconciling":false},{"name":"projects/scopebnb/locations/us-central1/backends/scopebnb/builds/build-2026-09-10-009","state":"