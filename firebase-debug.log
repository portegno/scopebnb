b\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0\",\"appId\":\"1:545100308806:web:53f12e90e180139c470547\",\"authDomain\":\"scopebnb.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"545100308806\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"scopebnb-545100308806.us-central1.run.app,scopebnb-ew6odra35q-uc.a.run.app,t-277106828---scopebnb-ew6odra35q-uc.a.run.app,scopebnb--scopebnb.us-central1.hosted.app,scopebnb.com,www.scopebnb.com","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"b94b02d330d598b6643da0ffaa1d37884fe1d49e","hash":"b94b02d330d598b6643da0ffaa1d37884fe1d49e","commitMessage":"A booking remembers the campaign link it came from\n\nThe last link in the chain. The cookie the proxy set --possibly weeks ago, from\na cold email, on a different day than this booking-- rides into the booking, so\nthe agency can tell which club a sale came from.\n\nThat gap is the whole reason the cookie exists: a club takes the idea to a\nmeeting and comes back later, and without this the booking arrives belonging to\nnobody. Until now \"what did it cost us to get this customer\" was a division --\ntotal spend over total sales -- which does not say that the spend caused the\nsale.\n\nThe field is only written when there is one: a field that is sometimes null and\nsometimes absent reads the same, and absent is the honest shape for a customer\nwho did not come from a campaign.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","uri":"https://github.com/portegno/scopebnb/commit/b94b02d330d598b6643da0ffaa1d37884fe1d49e","author":{"displayName":"portegno","email":"gabriel@portegno.com","imageUri":"https://github.com/portegno.png"},"commitTime":"2026-09-10T14:09:52Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/eb44dfa0-fd0a-4783-a3c1-4115bce98a44?project=545100308806","createTime":"2026-09-10T14:10:07.396433516Z","updateTime":"2026-09-10T14:13:09.417621Z","displayName":"build-2026-09-10-007","uid":"e314b291-5f4b-4eb0-9c55-fbfd76ec2dde","etag":"I3T30-IDdtAXlbwRT0wjNQ2vgyS-Rk5lML_TvKMBCII","reconciling":false},{"name":"projects/scopebnb/locations/us-central1/backends/scopebnb/builds/build-2026-09-10-006","state":"READY","image":"us-central1-docker.pkg.dev/scopebnb/firebaseapphosting-images/scopebnb:build-2026-09-10-006","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"scopebnb.firebaseapp.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"scopebnb","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"scopebnb.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"545100308806","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:545100308806:web:49692d66e4a1be12470547","availability":["BUILD","RUNTIME"]},{"variable":"GEMINI_MODEL","value":"gemini-2.5-flash-lite","availability":["BUILD","RUNTIME"]},{"variable":"GEMINI_API_KEY","secret":"projects/545100308806/secrets/GEMINI_API_KEY/versions/1","availability":["RUNTIME"]},{"variable":"SESSION_INGEST_SECRET","secret":"projects/545100308806/secrets/SESSION_INGEST_SECRET/versions/1","availability":["RUNTIME"]},{"variable":"SUPER_ADMIN_EMAILS","value":"gabriel@pul