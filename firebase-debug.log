EM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"scopebnb-545100308806.us-central1.run.app,scopebnb-ew6odra35q-uc.a.run.app,t-2745869171---scopebnb-ew6odra35q-uc.a.run.app,scopebnb--scopebnb.us-central1.hosted.app,scopebnb.com,www.scopebnb.com","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"be606bc936851761d42c458dc5efb7770e84498a","hash":"be606bc936851761d42c458dc5efb7770e84498a","commitMessage":"Forecast: fix stale dates in production\n\nThe /api/forecast route was statically prerendered (export const\nrevalidate = 3600), so Firebase App Hosting cached the build-day\nsnapshot behind a year-long stale-while-revalidate window and the grid\nfroze at the build date. Make the route dynamic (revalidate = 0) so the\n7-day window always starts at today, while keeping the upstream\nOpen-Meteo/7Timer fetches cached for an hour via an explicit per-fetch\nrevalidate. Also build the demo fallback per request instead of at\nmodule load, so its dates never freeze either.\n\nCo-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>","uri":"https://github.com/portegno/scopebnb/commit/be606bc936851761d42c458dc5efb7770e84498a","author":{"displayName":"portegno","email":"gabriel@portegno.com","imageUri":"https://github.com/portegno.png"},"commitTime":"2026-08-12T23:58:09Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/efad2bed-d7a8-4a7e-af4f-e1ab1a975777?project=545100308806","createTime":"2026-08-12T23:58:18.143559689Z","updateTime":"2026-08-13T00:01:20.347391Z","displayName":"build-2026-08-12-001","uid":"a0fa1d00-b3fc-4014-968e-3fd3bb85a8a3","etag":"_J1Dg9VAf5k_O_m5eva0moE3jYz_Qf7QCCQwLMTZYpM","reconciling":false},{"name":"projects/scopebnb/locations/us-central1/backends/scopebnb/builds/build-2026-09-02-002","state":"READY","image":"us-central1-docker.pkg.dev/scopebn