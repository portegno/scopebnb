ecrets/RESEND_API_KEY/versions/1","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"NEWSLETTER_FROM","value":"ScopeBnB <contact@scopebnb.com>","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"RESEND_AUDIENCE_ID","value":"ebd3fb5c-bfb4-4709-ab2a-f27eed5c46e0","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"NEXT_PUBLIC_GA_ID","value":"G-F58PHV4VN9","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0\",\"appId\":\"1:545100308806:web:53f12e90e180139c470547\",\"authDomain\":\"scopebnb.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"545100308806\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"scopebnb-545100308806.us-central1.run.app,scopebnb-ew6odra35q-uc.a.run.app,t-277106819---scopebnb-ew6odra35q-uc.a.run.app,scopebnb--scopebnb.us-central1.hosted.app,scopebnb.com,www.scopebnb.com","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"99544ab3170c65200fd73eb360e97af29004f433","hash":"99544ab3170c65200fd73eb360e97af29004f433","commitMessage":"No em dashes in the landings, and a lint that says so\n\nHouse style is \"Inglés, sin guiones largos, sin segunda persona\", and it lived\nonly inside a prompt -- so it bound the agents writing blog posts and nobody\nelse. The landings were written by hand and broke it on the first try, in the\nsentence carrying the whole offer: \"$300 for the week — across a membership...\".\nGabriel caught it reading the live page.\n\nEach one is rewritten by deciding what the dash was hiding -- a comma, a full\nstop, a \"which\" -- instead of swapping it for another mark. A dash traded for a\ncolon is the same sentence with the thinking still missing.\n\nAnd the rule moves out of the prompt into the lint, scoped to the landing files.\nA rule that only exists in a prompt binds whoever reads that prompt; this one now\nfails `npm run lint`, which is where a rule stops depending on memory. Comments\nare exempt: this is about what a reader sees.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","uri":"https://github.com/portegno/scopebnb/commit/99544ab3170c65200fd73eb360e97af29004f433","author":{"displayName":"portegno","email":"gabriel@portegno.com","imageUri":"https://github.com/portegno.png"},"commitTime":"2026-09-10T14:40:07Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/f7efb730-77b3-4a32-b1f2-29f36d056d17?project=545100308806","createTime":"2026-09-10T14:40:11.415811630Z","updateTime":"2026-09-10T14:43:23.748211Z","displayName":"build-2026-09-10-008","uid":"4e04094e-1aed-4aa1-953c-aa6b7c108708","etag":"yxVhTBoLa6NStE1S9Yf8TC7xL2Iw_UJHas1b-GPM6OY","reconciling":false},{"name":"projects/scopebnb/locations/us-central1/backends/scopebnb/builds/build-2026-09-10-003","state":"READY","image":"us-central1-docker.pkg.dev/scopebnb/firebaseapphosting-images/scopebnb:build-2026-09-10-003","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"scopebnb.firebaseapp.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_P