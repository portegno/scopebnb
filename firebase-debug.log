u.com","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"RESEND_API_KEY","secret":"projects/545100308806/secrets/RESEND_API_KEY/versions/1","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"NEWSLETTER_FROM","value":"ScopeBnB <contact@scopebnb.com>","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"RESEND_AUDIENCE_ID","value":"ebd3fb5c-bfb4-4709-ab2a-f27eed5c46e0","availability":["RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"NEXT_PUBLIC_GA_ID","value":"G-F58PHV4VN9","availability":["BUILD","RUNTIME"],"origin":"APPHOSTING_YAML","originFileName":"apphosting.yaml"},{"variable":"FIREBASE_CONFIG","value":"{\"databaseURL\":\"\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0\",\"appId\":\"1:545100308806:web:53f12e90e180139c470547\",\"authDomain\":\"scopebnb.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"545100308806\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"scopebnb-545100308806.us-central1.run.app,scopebnb-ew6odra35q-uc.a.run.app,t-260329240---scopebnb-ew6odra35q-uc.a.run.app,scopebnb--scopebnb.us-central1.hosted.app,scopebnb.com,www.scopebnb.com","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"c7eb6b6508317e1b16847546eaa48c7b5d8d55be","hash":"c7eb6b6508317e1b16847546eaa48c7b5d8d55be","commitMessage":"Real targets on the club landing\n\nAndromeda and the Elephant's Trunk, wide and detail, shot on this rig. For\nsomebody who photographs, one look at a finished M31 says more than every\nsentence above it -- and almost no business gets to argue this way, because\nalmost none produces its evidence as the product.\n\nThey go **before** the raw sub, not after: a club decides looking at what comes\nout. The single 180-second frame explains how it gets there, and that only\ninterests someone who is already interested.\n\n**The capture line is deliberately empty.** Hours, filter and frame count are\nthe part an astrophotographer actually reads -- \"5 hours of narrowband\" is a\nclaim about the rig, the sky and the mount at once -- and they are exactly the\nnumbers that would be easy to invent and impossible for a visitor to check.\nThere was no EXIF on the files, so the component draws nothing until somebody\nwho knows fills them in. Same rule as the proof block: a gap does not get filled\nwith something that sounds right.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","uri":"https://github.com/portegno/scopebnb/commit/c7eb6b6508317e1b16847546eaa48c7b5d8d55be","author":{"displayName":"portegno","email":"gabriel@portegno.com","imageUri":"https://github.com/portegno.png"},"commitTime":"2026-09-10T15:12:14Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/dc0e6ce7-90cb-43a5-af05-83faa662e672?project=545100308806","createTime":"2026-09-10T15:12:18.098124785Z","updateTime":"2026-09-10T15:15:00.039055Z","displayName":"build-2026-09-10-010","uid":"ed253174-ae31-4e57-bbfd-d0f1c54f5e37","etag":"gZ8hBrj-nqGQBz2b5Xjkjko-jqJx9sd4tv0dq-3ZFaE","reconciling":false},{"name":"projects/scopebnb/locations/us-central1/backends/scopebnb/builds/build-2026-09-10-011","state":"READY","image":"us-central1-docker.pkg.dev/scopebnb/firebaseapphosting-images/scopebnb:build-2026-09-10-011","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBA