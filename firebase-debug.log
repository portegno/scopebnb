,"availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0\",\"appId\":\"1:545100308806:web:53f12e90e180139c470547\",\"authDomain\":\"scopebnb.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"545100308806\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"scopebnb-545100308806.us-central1.run.app,scopebnb-ew6odra35q-uc.a.run.app,t-2982868883---scopebnb-ew6odra35q-uc.a.run.app,scopebnb--scopebnb.us-central1.hosted.app,scopebnb.com,www.scopebnb.com","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"150f2cd44af1eed81d2829dd6f2b0d41bc936c83","hash":"150f2cd44af1eed81d2829dd6f2b0d41bc936c83","commitMessage":"The editor stops throwing away what an email layout is made of\n\nTipTap drops every tag and attribute it has not been told about. That is right\nfor a blog post, where the markup should stay clean, and wrong for a newsletter:\nthe two column blocks are tables, and every colour and margin lives in a `style`\nbecause email clients ignore stylesheets. Parsed without them, the layout came\nback as a stack of paragraphs. That is what happened to Mike's tip, and that is\nhow it was found.\n\nTwo additions. `TableKit` so tables survive the round trip, and `KeepAttrs`, a\nglobal attribute extension that keeps `style` plus `width`, `align` and `valign`\non tables, cells, paragraphs, headings and images. Those three are attributes and\nnot CSS on purpose: Outlook ignores the stylesheet and obeys the attribute, so an\nemail carries both, and losing them collapses a row into a stack.\n\nThis does not make the editor a safe place to design an email. It makes the round\ntrip lossless enough that opening one to fix a line does not destroy it, which is\nthe thing anyone actually wants to do.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","uri":"https://github.com/portegno/scopebnb/commit/150f2cd44af1eed81d2829dd6f2b0d41bc936c83","author":{"displayName":"portegno","email":"gabriel@portegno.com","imageUri":"https://github.com/portegno.png"},"commitTime":"2026-09-06T19:19:21Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/381b5be7-11fa-463b-88fd-039daa412644?project=545100308806","createTime":"2026-09-06T19:19:26.838569876Z","updateTime":"2026-09-06T19:22:08.761447Z","displayName":"build-2026-09-06-009","uid":"843ba7cf-e77c-4ad1-897b-b88267d6344b","etag":"75xOxuMio-y4fbVB0jHTX2i9-7lj4UJI-sC1mYBfLas","reconciling":false},{"name":"projects/scopebnb/locations/us-central1/backends/scopebnb/builds/build-2026-09-06-002","state":"READY","image":"us-central1-docker.pkg.dev/scopebnb/firebaseapphosting-images/scopebnb:build-2026-09-06-002","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"scopebnb.firebaseapp.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"scopebnb","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"scopebnb.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"545100308806","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:545100308806:web:49692d66e4a1be12470547","availability":["BUILD","RUNTIME"]},{"variable":"GEMINI_MODEL","value":"gemini-2.5-flash-lite","availability":["BUILD","RUNTIME"]},{"variable":"GEMINI_API_KEY","secret":"projects/545100308806/secr