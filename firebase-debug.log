"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0\",\"appId\":\"1:545100308806:web:53f12e90e180139c470547\",\"authDomain\":\"scopebnb.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"545100308806\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"scopebnb-545100308806.us-central1.run.app,scopebnb-ew6odra35q-uc.a.run.app,t-2982868891---scopebnb-ew6odra35q-uc.a.run.app,scopebnb--scopebnb.us-central1.hosted.app,scopebnb.com,www.scopebnb.com","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"e7f6eba22426475924fa8f745e913186f2f1e692","hash":"e7f6eba22426475924fa8f745e913186f2f1e692","commitMessage":"Newsletter: editions can be written by the team and sent by a person\n\nThe panel sent as soon as you hit the button: `CampaignStatus` was\n`sent | failed`, so there was nowhere to leave an edition written and waiting.\nThat is what kept the Portegno team from writing them at all. Sending an email\nis the most irreversible thing in the system: a post can be unpublished and a\nforum snippet discarded before posting, but an email that went out does not come\nback.\n\n`borrador` is the missing state. The team writes the edition into\n`newsletterCampaigns` with that status; the panel lists them above the composer,\nloads one on click, and **a person still has to read it and press Send**. Same\nsplit that already applies to publishing a post.\n\nDrafts are not history: `listCampaigns` filters them out, because nobody has\nread them yet. And a draft is dropped once it goes out, so the same edition\nnever shows twice, once as waiting and once as sent.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","uri":"https://github.com/portegno/scopebnb/commit/e7f6eba22426475924fa8f745e913186f2f1e692","author":{"displayName":"portegno","email":"gabriel@portegno.com","imageUri":"https://github.com/portegno.png"},"commitTime":"2026-09-06T17:26:51Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/bc3d705a-3753-4957-bcbb-880d66085229?project=545100308806","createTime":"2026-09-06T17:27:14.649510437Z","updateTime":"2026-09-06T17:30:37.135998Z","displayName":"build-2026-09-06-001","uid":"23c22aaa-ad6f-4d02-ab6a-e197a1fd841f","etag":"blYaYioVo4VLMGOlxoqAgHkiWI7LzIWguTGnMaG5b2U","reconciling":false},{"name":"projects/scopebnb/locations/us-central1/backends/scopebnb/builds/build-2026-09-06-006","state":"READY","image":"us-central1-docker.pkg.dev/scopebnb/firebaseapphosting-images/scopebnb:build-2026-09-06-006","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"scopebnb.firebaseapp.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"scopebnb","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"scopebnb.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"545100308806","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:545100308806:web:49692d66e4a1be12470547","availability":["BUILD","RUNTIME"]},{"variable":"GEMINI_MODEL","value":"gemini-2.5-flash-lite","availability":["BUILD","RUNTIME"]},{"variable":"GEMINI_API_KEY","secret":"projects/545100308806/secrets/GEMINI_API_KEY/versions/1","availability":["RUNTIME"]},{"variable":"SESSION_INGEST_SECRET","secret":"projects/545100308806/secrets/SESSION_INGEST_SECRET/versions/1","availability":["RUNTIME"]},{"v