PP_CONFIG","value":"{\"apiKey\":\"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0\",\"appId\":\"1:545100308806:web:53f12e90e180139c470547\",\"authDomain\":\"scopebnb.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"545100308806\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"scopebnb-545100308806.us-central1.run.app,scopebnb-ew6odra35q-uc.a.run.app,t-2982868882---scopebnb-ew6odra35q-uc.a.run.app,scopebnb--scopebnb.us-central1.hosted.app,scopebnb.com,www.scopebnb.com","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"54f161fa1aa9d7569c8d7b4d226bf6fcadc6e05b","hash":"54f161fa1aa9d7569c8d7b4d226bf6fcadc6e05b","commitMessage":"Mobile preview, and a Visual tab that says what it costs\n\n**Mobile.** An email gets opened on a phone more than on a desktop, and the two\ncolumn row is the first thing that breaks there: the thumbnail and the text stop\nfitting side by side. The iframe narrows to 375px instead of scaling: scaling\nwould show the same layout smaller, which is exactly what you do not need to\nsee. At 375 it reflows for real.\n\n**Visual.** The source pane toggles between HTML and a WYSIWYG. They are not\nequivalent and pretending otherwise would be the lie: TipTap parses against its\nown schema and drops the tables and inline styles, which is the layout design\nbuilt. It flattened Mike's tip once already, and that is how we found out.\n\nSo looking in Visual costs nothing and typing there does, and the warning shows\nup exactly there: above the editor, once, and it goes away the moment you accept\nit by typing. Good for fixing a line, not for keeping the layout.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","uri":"https://github.com/portegno/scopebnb/commit/54f161fa1aa9d7569c8d7b4d226bf6fcadc6e05b","author":{"displayName":"portegno","email":"gabriel@portegno.com","imageUri":"https://github.com/portegno.png"},"commitTime":"2026-09-06T19:14:01Z"}},"buildLogsUri":"https://console.cloud.google.com/cloud-build/builds;region=us-central1/5afec8b2-af6c-4acb-b908-733a32b57c07?project=545100308806","createTime":"2026-09-06T19:14:06.213693169Z","updateTime":"2026-09-06T19:18:29.365525Z","displayName":"build-2026-09-06-008","uid":"ca59b624-a5da-47dc-aa34-0015af518d23","etag":"qRMtzZYuopwHtYAQPxYEOeuOCYOdneyy_SOvIvPC0Jw","reconciling":false},{"name":"projects/scopebnb/locations/us-central1/backends/scopebnb/builds/build-2026-09-06-009","state":"READY","image":"us-central1-docker.pkg.dev/scopebnb/firebaseapphosting-images/scopebnb:build-2026-09-06-009","config":{"runConfig":{"cpu":1,"memoryMib":512,"concurrency":80,"maxInstances":10},"env":[{"variable":"NEXT_PUBLIC_FIREBASE_API_KEY","value":"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN","value":"scopebnb.firebaseapp.com","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_PROJECT_ID","value":"scopebnb","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET","value":"scopebnb.firebasestorage.app","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID","value":"545100308806","availability":["BUILD","RUNTIME"]},{"variable":"NEXT_PUBLIC_FIREBASE_APP_ID","value":"1:545100308806:web:49692d66e4a1be12470547","availability":["BUILD","RUNTIME"]},{"variable":"GEMINI_MODEL","value":"gemini-2.5-flash-lite","availability":["BUILD","RUNTIME"]},{"variable":"GEMINI_API_KEY","secret":"projects/545100308806/secrets/GEMINI_API_KEY/versions/1","availability":["RUNTIME"]},{"variable":"SESSION_INGEST_SECRET","secret":"projects/545100308806/secrets/SESSION_INGEST_SECRET/versions/1","availability":["RUNTIME"]},{"variable":"SUPER_ADMIN_E