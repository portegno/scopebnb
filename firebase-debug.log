firebasestorage.app\"}","availability":["BUILD","RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"FIREBASE_WEBAPP_CONFIG","value":"{\"apiKey\":\"AIzaSyB2_bWFjvM3eBrOCdmINRONo8fNNt4leh0\",\"appId\":\"1:545100308806:web:53f12e90e180139c470547\",\"authDomain\":\"scopebnb.firebaseapp.com\",\"databaseURL\":\"\",\"messagingSenderId\":\"545100308806\",\"projectId\":\"scopebnb\",\"storageBucket\":\"scopebnb.firebasestorage.app\"}","availability":["BUILD"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_TRUST_PROXY_HEADERS","value":"X-Forwarded-Host","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"},{"variable":"NG_ALLOWED_HOSTS","value":"scopebnb-545100308806.us-central1.run.app,scopebnb-ew6odra35q-uc.a.run.app,t-2982868892---scopebnb-ew6odra35q-uc.a.run.app,scopebnb--scopebnb.us-central1.hosted.app,scopebnb.com,www.scopebnb.com","availability":["RUNTIME"],"origin":"FIREBASE_SYSTEM"}]},"source":{"codebase":{"branch":"main","displayName":"cecf4eb35867a87f46a37062b202aef6c1499ae6","hash":"cecf4eb35867a87f46a37062b202aef6c1499ae6","commitMessage":"An edition written by the team is looked at, not edited\n\nIts HTML is real email HTML: tables for the two-column blocks, inline styles,\nmarkup no WYSIWYG knows. TipTap parses against its own schema and drops what it\ndoes not recognise, so loading a team edition into the composer flattened\nMike's tip into a stack and would have sent that.\n\nOpen now shows the actual email in an iframe, rendered through the same wrapper\nthat goes out, and sends it as it is. An iframe and not a div because the email\nbrings its own `<style>` and its own `<body>`: injected into the page, its rules\nmix with the admin's and what you see stops being what you send.\n\nEdit by hand is still there as an escape hatch, and it says what it costs before\ndoing it: the layout goes.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","uri":"https://github.com/portegno/scopebnb/commit/cecf4eb35867a87f46a37062b202aef6c1499ae6","author":{"displayName":"